{
  "schemaVersion": 1,
  "id": "better-chestlock",
  "version": "${version}",
  "name": "Better Chestlock",
  "description": "Locks your chests so only you and trusted players can open or break them. Owner protection, global player trust, hopper blocking, explosion resistance and simple server commands.",
  "authors": [
    "slxca"
  ],
  "contact": {
    "homepage": "https://github.com/slxca/better-chestlock",
    "sources": "https://github.com/slxca/better-chestlock",
    "issues": "https://github.com/slxca/better-chestlock/issues"
  },
  "license": "MIT",
  "icon": "assets/better-chestlock/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.slxca.betterChestlock.client.datagen.BetterChestlockDataGenerator"
    ],
    "main": [
      "com.slxca.betterChestlock.BetterChestlock"
    ]
  },
  "mixins": [
    "better-chestlock.mixins.json",
    {
      "config": "better-chestlock.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}